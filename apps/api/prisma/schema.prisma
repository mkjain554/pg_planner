generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  PLATFORM_ADMIN
  OWNER
  PROPERTY_MANAGER
  CARETAKER
}

enum PropertyType {
  PG
  HOSTEL
  CO_LIVING
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
  OTHER
}

enum BedStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum OccupancyStatus {
  ACTIVE
  CHECKED_OUT
  CANCELLED
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique @db.VarChar(320)
  fullName     String             @db.VarChar(160)
  phone        String?            @db.VarChar(32)
  passwordHash String             @db.VarChar(255)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  OrganizationMember[]
  tenants      Tenant[]
  auditLogs    AuditLog[]
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(160)
  slug      String               @unique @db.VarChar(180)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  properties Property[]
  tenants   Tenant[]
  auditLogs AuditLog[]
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Property {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  name                  String         @db.VarChar(160)
  code                  String         @db.VarChar(40)
  type                  PropertyType   @default(PG)
  addressLine1          String         @db.VarChar(200)
  addressLine2          String?        @db.VarChar(200)
  locality              String         @db.VarChar(120)
  city                  String         @db.VarChar(120)
  state                 String         @db.VarChar(120)
  postalCode            String         @db.VarChar(16)
  country               String         @default("India") @db.VarChar(80)
  description           String?        @db.VarChar(1000)
  contactName           String?        @db.VarChar(120)
  contactPhone          String?        @db.VarChar(32)
  defaultBillingDay     Int            @default(1)
  currency              String         @default("INR") @db.Char(3)
  status                PropertyStatus @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rooms                 Room[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, city])
}

model Room {
  id          String     @id @default(uuid()) @db.Uuid
  propertyId  String     @db.Uuid
  organizationId String  @db.Uuid
  identifier  String     @db.VarChar(40)
  floor       String     @db.VarChar(40)
  type        RoomType   @default(OTHER)
  capacity    Int
  description String?    @db.VarChar(600)
  status      RoomStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  property    Property   @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  beds        Bed[]

  @@unique([propertyId, identifier])
  @@unique([id, organizationId])
  @@index([propertyId, floor, status])
}

model Bed {
  id            String     @id @default(uuid()) @db.Uuid
  roomId        String     @db.Uuid
  organizationId String   @db.Uuid
  label         String     @db.VarChar(40)
  code          String?    @db.VarChar(40)
  monthlyRent   Decimal    @db.Decimal(12, 2)
  depositAmount Decimal    @default(0) @db.Decimal(12, 2)
  status        BedStatus  @default(AVAILABLE)
  notes         String?    @db.VarChar(600)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  room          Room       @relation(fields: [roomId, organizationId], references: [id, organizationId], onDelete: Restrict)
  occupancies   Occupancy[]

  @@unique([roomId, label])
  @@unique([id, organizationId])
  @@index([roomId, status])
}

model Tenant {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  fullName       String      @db.VarChar(160)
  phone          String      @db.VarChar(32)
  email          String?     @db.VarChar(320)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  occupancies    Occupancy[]

  @@index([organizationId, fullName])
  @@index([organizationId, phone])
  @@unique([id, organizationId])
}

model Occupancy {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @db.Uuid
  tenantId             String          @db.Uuid
  bedId                String          @db.Uuid
  checkIn              DateTime        @db.Date
  plannedCheckOut       DateTime?       @db.Date
  actualCheckOut        DateTime?       @db.Date
  agreedMonthlyRent     Decimal         @db.Decimal(12, 2)
  agreedDeposit         Decimal         @db.Decimal(12, 2)
  status                OccupancyStatus @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenant                Tenant          @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  bed                   Bed             @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, status, checkIn])
  @@index([bedId, status, checkIn])
  @@index([tenantId, status])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @db.VarChar(80)
  entityId       String?      @db.Uuid
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
